rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userRecord() {
      // Roles and active status are stored separately from Firebase Auth so an
      // account can be disabled without deleting its authentication identity.
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function authorized() {
      return signedIn() && userRecord().data.active == true;
    }

    function editor() {
      return authorized() && userRecord().data.role in ['admin', 'processor'];
    }

    function administrator() {
      return authorized() && userRecord().data.role == 'admin';
    }

    function validDecisionNumber() {
      // REMC has a stricter official-number format; other issuance types retain
      // their source-specific reference formats.
      return request.resource.data.issuance_type != 'REMC'
        || (request.resource.data.reference_number is string
          && request.resource.data.reference_number.matches('^REMC-[0-9]{4}-[0-9]+[A-Z]?$'));
    }

    function validTemporaryLicense() {
      // A TLS always carries normalized issuance and expiry dates. The form
      // calculates the expiry as one calendar year after issuance.
      return request.resource.data.issuance_type != 'Temporary License to Sell'
        || (request.resource.data.date_issued is string
          && request.resource.data.expiry_date is string
          && request.resource.data.date_issued.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.expiry_date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    function referenceReserved(issuanceId) {
      // getAfter verifies the companion reservation as it will exist after the
      // transaction commits, making the uniqueness protocol atomic.
      return request.resource.data.reference_key is string
        && existsAfter(/databases/$(database)/documents/issuance_reference_numbers/$(request.resource.data.reference_key))
        && getAfter(/databases/$(database)/documents/issuance_reference_numbers/$(request.resource.data.reference_key)).data.issuance_id == issuanceId;
    }

    function legacyReferenceUnchanged() {
      // Imported records created before reservations were introduced remain
      // editable only while their original reference number is unchanged.
      return !('reference_key' in resource.data)
        && !('reference_key' in request.resource.data)
        && request.resource.data.reference_number == resource.data.reference_number;
    }

    match /issuances/{issuanceId} {
      // Viewers may read; processors/admins edit; only admins permanently delete.
      allow read: if authorized();
      allow create: if editor() && validDecisionNumber() && validTemporaryLicense() && referenceReserved(issuanceId);
      allow update: if editor() && validDecisionNumber() && validTemporaryLicense()
        && (legacyReferenceUnchanged() || referenceReserved(issuanceId));
      allow delete: if administrator()
        && (!('reference_key' in resource.data)
          || !existsAfter(/databases/$(database)/documents/issuance_reference_numbers/$(resource.data.reference_key)));
    }

    match /issuance_reference_numbers/{referenceKey} {
      // Each canonical reference key points to exactly one issuance. Both sides
      // must be written or removed in the same transaction.
      allow read: if authorized();
      allow create: if editor()
        && request.resource.data.issuance_id is string
        && existsAfter(/databases/$(database)/documents/issuances/$(request.resource.data.issuance_id))
        && getAfter(/databases/$(database)/documents/issuances/$(request.resource.data.issuance_id)).data.reference_key == referenceKey;
      allow update: if editor()
        && request.resource.data.issuance_id == resource.data.issuance_id
        && existsAfter(/databases/$(database)/documents/issuances/$(request.resource.data.issuance_id))
        && getAfter(/databases/$(database)/documents/issuances/$(request.resource.data.issuance_id)).data.reference_key == referenceKey;
      allow delete: if editor() && resource.data.issuance_id is string
        && ((administrator()
            && !existsAfter(/databases/$(database)/documents/issuances/$(resource.data.issuance_id)))
          || (existsAfter(/databases/$(database)/documents/issuances/$(resource.data.issuance_id))
            && getAfter(/databases/$(database)/documents/issuances/$(resource.data.issuance_id)).data.reference_key != referenceKey));
    }

    match /users/{userId} {
      // Users can bootstrap by reading their own profile. Broader user directory
      // access requires authorization, and only admins may manage accounts.
      allow get: if signedIn() && userId == request.auth.uid;
      allow list: if authorized();
      allow create, update, delete: if administrator();
    }
  }
}
