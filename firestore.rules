rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userRecord() {
      // Roles and active status are stored separately from Firebase Auth so an
      // account can be disabled without deleting its authentication identity.
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function authorized() {
      return signedIn() && userRecord().data.active == true;
    }

    function editor() {
      return authorized() && userRecord().data.role in ['admin', 'processor'];
    }

    function administrator() {
      return authorized() && userRecord().data.role == 'admin';
    }

    function validDecisionNumber() {
      // REMC has a stricter official-number format; other issuance types retain
      // their source-specific reference formats.
      return request.resource.data.issuance_type != 'REMC'
        || (request.resource.data.reference_number is string
          && request.resource.data.reference_number.matches('^REMC-[0-9]{4}-[0-9]+[A-Z]?$'));
    }

    function validTemporaryLicense() {
      // A TLS always carries normalized issuance and expiry dates. The form
      // calculates the expiry as one calendar year after issuance.
      return request.resource.data.issuance_type != 'Temporary License to Sell'
        || (request.resource.data.date_issued is string
          && request.resource.data.expiry_date is string
          && request.resource.data.date_issued.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.expiry_date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    function validConditionalLicense() {
      // CLS amounts are integer centavos; enforce the same 25%-100% range as
      // the form, including requests made directly against Firestore.
      let data = request.resource.data;
      return data.issuance_type != 'Conditional License to Sell (CLS)'
        || (data.date_issued is string && data.expiry_date is string
          && data.date_issued.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && data.expiry_date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && data.expiry_date >= data.date_issued
          && data.escrow_total_centavos is int && data.escrow_paid_centavos is int
          && data.escrow_total_centavos > 0 && data.escrow_total_centavos <= 999999999999999
          && data.escrow_paid_centavos * 4 >= data.escrow_total_centavos
          && data.escrow_paid_centavos <= data.escrow_total_centavos);
    }

    function referenceReserved(issuanceId) {
      // getAfter verifies the companion reservation as it will exist after the
      // transaction commits, making the uniqueness protocol atomic.
      return request.resource.data.reference_key is string
        && existsAfter(/databases/$(database)/documents/issuance_reference_numbers/$(request.resource.data.reference_key))
        && getAfter(/databases/$(database)/documents/issuance_reference_numbers/$(request.resource.data.reference_key)).data.issuance_id == issuanceId;
    }

    function legacyReferenceUnchanged() {
      // Imported records created before reservations were introduced remain
      // editable only while their original reference number is unchanged.
      return !('reference_key' in resource.data)
        && !('reference_key' in request.resource.data)
        && request.resource.data.reference_number == resource.data.reference_number;
    }

    function protectedLegacyNumberUnchanged() {
      let number = request.resource.data.reference_number.upper().replace('^\\s+|\\s+$', '');
      return !(number in ['REMC-2025-152', 'REMC-2025-158', '2026/06-15'])
        || (resource != null && request.resource.data.reference_number == resource.data.reference_number);
    }

    function auditValid(issuanceId, before, after) {
      let entry = getAfter(/databases/$(database)/documents/issuances/$(issuanceId)/history/$(after.history_id)).data;
      return after.history_id is string && after.version is int
        && after.version == (before == null ? 0 : before.get('version', 0)) + 1
        && (before == null || after.history_id != before.get('history_id', ''))
        && after.updated_at == request.time && after.updated_by == userRecord().data.name
        && after.archived is bool
        && entry.keys().hasOnly(['action', 'reason', 'actor_id', 'actor_name', 'at', 'version', 'before', 'after'])
        && entry.before == before && entry.after == after
        && entry.at == request.time && entry.version == after.version
        && entry.actor_id == request.auth.uid && entry.actor_name == userRecord().data.name
        && entry.reason is string && entry.reason.size() > 0 && entry.reason.size() <= 1000
        && entry.reason.matches('(?s).*\\S.*')
        && ((before == null && entry.action == 'create' && after.archived == false && after.created_at == request.time)
          || (before != null && after.created_at == before.created_at
            && (after.reference_number != before.reference_number
              || !('reference_key' in before) || after.reference_key == before.reference_key)
            && ((entry.action in ['update', 'revert'] && !before.get('archived', false) && !after.archived
                && (entry.action != 'revert' || administrator()))
              || (administrator()
                && after.diff(before).affectedKeys().hasOnly(['archived', 'version', 'history_id', 'updated_at', 'updated_by', 'reference_key'])
                && ((entry.action == 'archive' && !before.get('archived', false) && after.archived)
                  || (entry.action == 'restore' && before.get('archived', false) && !after.archived))))));
    }

    match /issuances/{issuanceId} {
      allow read: if authorized();
      allow create: if editor() && protectedLegacyNumberUnchanged() && validDecisionNumber() && validTemporaryLicense() && validConditionalLicense()
        && referenceReserved(issuanceId) && auditValid(issuanceId, null, request.resource.data);
      allow update: if editor() && protectedLegacyNumberUnchanged() && validDecisionNumber() && validTemporaryLicense() && validConditionalLicense()
        && (legacyReferenceUnchanged() || referenceReserved(issuanceId))
        && auditValid(issuanceId, resource.data, request.resource.data);
      // Archive keeps both the record and its number. No client can permanently
      // delete records, including their immutable history subcollection.
      allow delete: if false;

      match /history/{historyId} {
        allow read: if authorized();
        allow create: if editor()
          && getAfter(/databases/$(database)/documents/issuances/$(issuanceId)).data.history_id == historyId
          && auditValid(issuanceId,
            exists(/databases/$(database)/documents/issuances/$(issuanceId))
              ? get(/databases/$(database)/documents/issuances/$(issuanceId)).data : null,
            getAfter(/databases/$(database)/documents/issuances/$(issuanceId)).data);
        allow update, delete: if false;
      }
    }

    match /issuance_reference_numbers/{referenceKey} {
      // Each canonical reference key points to exactly one issuance. Both sides
      // must be written or removed in the same transaction.
      allow read: if authorized();
      allow create: if editor()
        && request.resource.data.issuance_id is string
        && existsAfter(/databases/$(database)/documents/issuances/$(request.resource.data.issuance_id))
        && getAfter(/databases/$(database)/documents/issuances/$(request.resource.data.issuance_id)).data.reference_key == referenceKey;
      allow update: if editor()
        && request.resource.data.issuance_id == resource.data.issuance_id
        && existsAfter(/databases/$(database)/documents/issuances/$(request.resource.data.issuance_id))
        && getAfter(/databases/$(database)/documents/issuances/$(request.resource.data.issuance_id)).data.reference_key == referenceKey;
      allow delete: if editor() && resource.data.issuance_id is string
        && ((administrator()
            && !existsAfter(/databases/$(database)/documents/issuances/$(resource.data.issuance_id)))
          || (existsAfter(/databases/$(database)/documents/issuances/$(resource.data.issuance_id))
            && getAfter(/databases/$(database)/documents/issuances/$(resource.data.issuance_id)).data.reference_key != referenceKey));
    }

    match /users/{userId} {
      // Users can bootstrap by reading their own profile. Broader user directory
      // access requires authorization, and only admins may manage accounts.
      allow get: if signedIn() && userId == request.auth.uid;
      allow list: if authorized();
      allow create, update, delete: if administrator();
    }
  }
}
